@model List<ScoutIQ.Models.Player>

<h1>Players</h1>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Age</th>
            <th>Overall</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var player in Model)
        {
            <tr>
                <td>@player.short_name</td>
                <td>@player.age</td>
                <td>@player.overall</td>
            </tr>
        }
    </tbody>
</table>