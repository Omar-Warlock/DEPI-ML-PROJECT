@model List<ScoutIQ.Models.Player>

<h2>Players Found</h2>

<table border="1">
    <tr>
        <th>Name</th>
        <th>Age</th>
        <th>Overall</th>
        <th>Potential</th>
        <th>Pace</th>
        <th>Shooting</th>
        <th>Passing</th>
        <th>Dribbling</th>
        <th>Defending</th>
        <th>Physic</th>
        <th>Market Value</th>
    </tr>

    @foreach (var player in Model)
    {
        <tr>
            <td>@player.short_name</td>
            <td>@player.age</td>
            <td>@player.overall</td>
            <td>@player.potential</td>
            <td>@player.pace</td>
            <td>@player.shooting</td>
            <td>@player.passing</td>
            <td>@player.dribbling</td>
            <td>@player.defending</td>
            <td>@player.physic</td>
            <td>@player.market_value_eur</td>
        </tr>
    }

</table>